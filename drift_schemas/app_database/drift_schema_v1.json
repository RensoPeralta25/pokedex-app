  "fixed_sql": [
    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL CHECK(\"id\" > 0), \"name\" TEXT NOT NULL, \"national_number\" INTEGER NULL, \"artwork_url\" TEXT NULL, \"sprite_url\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"types\" (\"name\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "pokemon_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_types\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"slot\" INTEGER NOT NULL CHECK(\"slot\" > 0), \"type_name\" TEXT NOT NULL REFERENCES types (name), PRIMARY KEY (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"pokemon_id\" INTEGER NOT NULL CHECK(\"pokemon_id\" > 0), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"resource_key\" TEXT NOT NULL, \"last_success_at\" TEXT NULL, \"next_offset\" INTEGER NULL CHECK(\"next_offset\" >= 0), \"status\" TEXT NOT NULL, PRIMARY KEY (\"resource_key\"));"
        }
      ]
    },
    {
      "name": "idx_pokemon_order",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_pokemon_order ON pokemon (national_number, id)"
        }
      ]
    },
    {
      "name": "idx_pokemon_name",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_pokemon_name ON pokemon (name)"
        }
      ]
